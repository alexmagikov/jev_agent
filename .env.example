JEV_API_KEY=
LLM_API_KEY=
LLM_API_PROTOCOL=anthropic
LLM_BASE_URL=https://claude.gigaparsers.ru/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_RESPONSE_FORMAT=text
LLM_OPENCODE_SESSION=test
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=0
LLM_MIN_REQUEST_INTERVAL_SECONDS=6
LLM_RATE_LIMIT_RETRIES=2
LLM_RATE_LIMIT_BACKOFF_SECONDS=30
# Optional USD per 1M tokens; use the rates of your actual provider/model.
# Qwen3.8-27B DeepInfra reference, 25% promotion checked 2026-10-28:
# LLM_INPUT_PRICE_PER_MILLION=0.15
# LLM_OUTPUT_PRICE_PER_MILLION=1.875
# Jev TypeSafe reference (a gateway may charge a different rate):
# DECISION_INPUT_PRICE_PER_MILLION=0.042
# DECISION_OUTPUT_PRICE_PER_MILLION=0
# Jeff: отдельный jeff-serve, текущий верификатор по умолчанию.
JEFF_BASE_URL=http://127.0.0.1:8765
JEFF_MODEL=jeff-latest
JEFF_TIMEOUT_SECONDS=120
JEFF_MAX_RETRIES=0
JEFF_WRONG_THRESHOLD=0.8
# JEFF_API_KEY=your-jeff-server-key
# CLM: альтернативный верификатор с --verifier clm.
CLM_BASE_URL=http://127.0.0.1:8700
CLM_MODEL=clm-latest
CLM_TIMEOUT_SECONDS=120
CLM_MAX_RETRIES=0
CLM_WRONG_THRESHOLD=0.8
# CLM_API_KEY=your-clm-server-key
# JEV_API_KEY нужен только с --verifier jev и для старых демонстраций.
# Laya: отдельный laya-serve, выбирается через --verifier laya.
LAYA_BASE_URL=http://127.0.0.1:8770
LAYA_MODEL=multilingual
LAYA_TIMEOUT_SECONDS=120
LAYA_MAX_RETRIES=0
LAYA_WRONG_THRESHOLD=0.8
LAYA_MAX_LEN=8192
LAYA_HEAD_MAX_LEN=2048
# LAYA_API_KEY=your-laya-server-key

# TypeSafe-compatible decision API (--verifier decision).
# DECISION_API_KEY takes precedence over the legacy JEV_API_KEY.
# Uncomment all three together to configure the decision API; LLM_* remains independent.
# DECISION_API_KEY=your_api_key
# DECISION_BASE_URL=https://polza.ai/api
# DECISION_MODEL=typesafe/jev
# DECISION_TIMEOUT_SECONDS=120
# DECISION_MAX_RETRIES=0
# DECISION_WRONG_THRESHOLD=0.8
